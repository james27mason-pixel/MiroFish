# ===== LLM (OpenAI-compatible) =====
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini

# ===== Zep Cloud graph memory =====
ZEP_API_KEY=your_zep_api_key_here

# ===== Public deployment security =====
# Use long unique random values. Never commit real values.
SECRET_KEY=replace_with_long_random_secret
MIROFISH_USERNAME=replace_with_private_username
MIROFISH_PASSWORD=replace_with_long_unique_password

# ===== Durable state for free Render deployments =====
# Copy a Supabase Postgres connection string into Render as a SECRET env var.
# Prefer Supabase's pooler connection string if the host requires IPv4.
# Never commit the real URL/password.
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres?sslmode=require
MIROFISH_SNAPSHOT_INTERVAL=30

# Optional local data-root override. On free Render this directory itself is
# ephemeral; SUPABASE_DB_URL is what makes projects/simulations/reports durable.
# MIROFISH_DATA_DIR=/tmp/mirofish-data

# ===== Optional boosted LLM =====
# Omit these entirely when unused.
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here
